APP_NAME=FugaziByUs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker service names are used as hosts (see docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fugazi
DB_USERNAME=fugazi
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches all local mail: http://localhost:8026
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@fugazibyus.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local ports (change if something on your Mac already uses them)
APP_PORT=8090
FORWARD_DB_PORT=33060
VITE_PORT=5173
MAILPIT_UI_PORT=8026

# --- AI workflow (filled in during later phases; see docs/SETUP-LOCAL.md) ---
# Locally, `ant auth login` is used automatically (no key needed). Only set a key here if
# you can't use the CLI login – an empty value would hide your login, so leave it commented.
# ANTHROPIC_API_KEY=
ANTHROPIC_WEBHOOK_SIGNING_KEY=
AI_REPOSITORY=fugazibyus/FugaziByUs
# The "Fugazi AI" GitHub App the agents act as (see docs/SETUP-AI.md). Keep the .pem out of git:
# storage/app/private/ is git-ignored.
AI_GITHUB_APP_ID=
AI_GITHUB_APP_PRIVATE_KEY_PATH=storage/app/private/fugazi-ai.pem
# Slack app (docs/SETUP-SLACK.md). Leave empty to run without Slack.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack member IDs for the people in config/team.php
TEAM_SLACK_SGOODWIN10=
# GitHub → app webhook (alerts) and the secret that signs Slack requests the app passes to GitHub Actions
GITHUB_WEBHOOK_SECRET=
AI_DISPATCH_SECRET=
AI_DAILY_BUDGET_USD=25
# Console link printed by ai:start (workspace "fugazibyus")
ANTHROPIC_CONSOLE_SESSION_URL=https://platform.claude.com/workspaces/wrkspc_01DEn4hN26qUxWFjG857Gb2i/sessions/{id}
