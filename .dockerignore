# Keeps the production image small and free of secrets. The build stage runs
# composer install and the Vite build itself, so local vendor/ and node_modules/ stay out.
.git
.github
.claude
.env
.env.*
!.env.example
*.pem
auth.json
node_modules
vendor
public/build
public/hot
public/storage
resources/js/actions
resources/js/routes
resources/js/wayfinder
storage/app/private/*
storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/pail
storage/*.key
bootstrap/cache/*.php
database/database.sqlite
tests
test-results
playwright-report
blob-report
.phpunit.cache
docs
slack
deploy
scripts
docker-compose.yml
Makefile
.DS_Store
.obsidian
.phpunit.result.cache
